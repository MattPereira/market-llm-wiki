---
interface Props {
  title: string;
  description?: string;
  /** Overrides `title` in share cards, which often show no other text. */
  ogTitle?: string;
  /** Site-relative path; pages without one get a text-only card. */
  ogImage?: string;
  ogType?: "website" | "article";
}

import SiteHeader from "@/components/SiteHeader.astro";
import { activeNav } from "../lib/nav";
import { OG_HEIGHT, OG_WIDTH } from "../lib/og";
import "../styles/global.css";

const {
  title,
  description,
  ogTitle = title,
  ogImage,
  ogType = "website",
} = Astro.props;

// Crawlers don't resolve relative URLs, so everything here is absolute.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage && new URL(ogImage, Astro.site);

const active = activeNav(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content={String(OG_WIDTH)} />
          <meta property="og:image:height" content={String(OG_HEIGHT)} />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <link rel="icon" href="data:," />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Blocking on purpose: both the palette and the toggle label have to be
      // settled before first paint, or the page flashes the wrong theme.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can throw when cookies are blocked; system default is fine.
        }
        // No stored choice seeds from the OS, but the toggle only offers light/dark.
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink text-lg antialiased">
    <SiteHeader active={active} />
    <main class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-6 sm:py-16">
      <slot />
    </main>
    <script is:inline>
      document.addEventListener("click", (event) => {
        if (!event.target.closest("#theme-toggle")) return;

        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";

        root.dataset.theme = next;
        root.style.colorScheme = next;

        try {
          localStorage.setItem("theme", next);
        } catch {
          // Preference just won't survive the reload.
        }
      });
    </script>
  </body>
</html>
