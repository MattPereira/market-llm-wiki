---
interface Props {
  title: string;
  description?: string;
}

import { Icon } from "astro-icon/components";
import { AppShell } from "@/components/AppShell";
import { activeNav } from "../lib/nav";
import "../styles/global.css";

const { title, description } = Astro.props;

const active = activeNav(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />
    <link
      rel="preload"
      href="/fonts/inter-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Blocking on purpose: both the palette and the toggle label have to be
      // settled before first paint, or the page flashes the wrong theme.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can throw when cookies are blocked; system default is fine.
        }
        // No stored choice seeds from the OS, but the toggle only offers light/dark.
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink text-lg antialiased">
    <AppShell client:load active={active}>
      <button
        slot="themeToggle"
        class="text-ink-muted hover:text-ink-strong p-2 text-base"
        id="theme-toggle"
        type="button"
      >
        <span class="sr-only">Theme:</span>
        <span data-theme-label="light">
          <span class="sr-only">Light</span>
          <Icon name="ri:sun-line" class="size-5" aria-hidden="true" />
        </span>
        <span data-theme-label="dark">
          <span class="sr-only">Dark</span>
          <Icon name="ri:moon-line" class="size-5" aria-hidden="true" />
        </span>
      </button>
      <div class="mx-auto w-full max-w-4xl px-5 py-10 sm:px-6 sm:py-16">
        <slot />
      </div>
    </AppShell>
    <script is:inline>
      // Delegated: the toggle sits inside the React island, which can swap the node out on hydration.
      document.addEventListener("click", (event) => {
        if (!event.target.closest("#theme-toggle")) return;

        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";

        root.dataset.theme = next;
        root.style.colorScheme = next;

        try {
          localStorage.setItem("theme", next);
        } catch {
          // Preference just won't survive the reload.
        }
      });
    </script>
  </body>
</html>
