---
import { formatShortDate, summaryCount } from "../lib/format";

export interface CreatorCard {
  href: string;
  name: string;
  count: number;
  latest: Date;
}

interface Props {
  creators: CreatorCard[];
}

const { creators } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    creators.map((creator) => (
      <li>
        <a
          class="group border-edge hover:border-ink-muted block h-full rounded-lg border p-5"
          href={creator.href}
        >
          <h2 class="font-serif text-xl font-semibold text-ink-strong group-hover:decoration-ink-muted group-hover:underline group-hover:underline-offset-4">
            {creator.name}
          </h2>
          <p class="mt-1 text-ink-muted text-base">
            {summaryCount(creator.count)} · latest{" "}
            <time datetime={creator.latest.toISOString()}>
              {formatShortDate(creator.latest)}
            </time>
          </p>
        </a>
      </li>
    ))
  }
</ul>
