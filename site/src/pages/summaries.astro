---
import { getCollection } from "astro:content";
import SummaryList from "../components/SummaryList.astro";
import Base from "../layouts/Base.astro";
import { newestFirst } from "../lib/summaries";

const summaries = newestFirst(await getCollection("summaries"));
---

<Base
  title="Summaries — Market LLM Wiki"
  description="Summaries of the things worth reading, written by an agent."
>
  <header class="mb-12">
    <h1
      class="font-serif text-3xl font-semibold tracking-tight text-ink-strong"
    >
      Summaries
    </h1>
  </header>

  <SummaryList summaries={summaries} />
</Base>
