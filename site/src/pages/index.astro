---
import { getCollection } from "astro:content";
import SummaryList from "../components/SummaryList.astro";
import Base from "../layouts/Base.astro";
import { summaryCount } from "../lib/format";
import { creatorSlug } from "../lib/summaries";
import { topicSlugs } from "../lib/topics";

const RECENT = 3;
const TAGLINE = "Agent-written summaries of market commentary.";

const summaries = await getCollection("summaries");
const recent = [...summaries]
  .sort((a, b) => b.data.created_at.valueOf() - a.data.created_at.valueOf())
  .slice(0, RECENT);

const creatorCount = new Set(summaries.map((s) => creatorSlug(s.id))).size;

const plural = (count: number, noun: string) =>
  `${count} ${count === 1 ? noun : `${noun}s`}`;

// Topics counts the whole vocabulary, matching what /topics/ lists.
const stats = [
  { href: "/summaries/", label: summaryCount(summaries.length) },
  { href: "/creators/", label: plural(creatorCount, "creator") },
  { href: "/topics/", label: plural(topicSlugs().length, "topic") },
];
---

<Base title="Market LLM Wiki" description={TAGLINE}>
  <div class="flex flex-col gap-10">
    <header>
      <h1
        class="font-serif text-4xl font-semibold tracking-tight text-ink-strong"
      >
        Market LLM Wiki
      </h1>
      <p class="mt-2 text-ink-muted text-base">
        {
          stats.map((stat, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a
                class="hover:text-ink-strong hover:underline hover:underline-offset-4"
                href={stat.href}
              >
                {stat.label}
              </a>
            </>
          ))
        }
      </p>
    </header>

    <section aria-labelledby="recent-heading">
      <h2
        id="recent-heading"
        class="border-edge mb-6 border-b pb-3 font-serif text-2xl font-semibold tracking-tight text-ink-strong"
      >
        Recent
      </h2>
      <SummaryList summaries={recent} headingLevel={3} compact />
      <div class="border-edge border-t pt-4 text-right">
        <a
          class="text-ink-muted hover:text-ink-strong text-base whitespace-nowrap"
          href="/summaries/">All summaries →</a
        >
      </div>
    </section>
  </div>
</Base>
