---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import TopicLinks from "../../components/TopicLinks.astro";
import Base from "../../layouts/Base.astro";
import { creatorName } from "../../lib/creators";
import { formatDate } from "../../lib/format";
import { creatorSlug } from "../../lib/summaries";

export const getStaticPaths: GetStaticPaths = async () => {
  const summaries = await getCollection("summaries");

  return summaries.map((summary) => {
    const [creator, ...rest] = summary.id.split("/");
    return { params: { creator, slug: rest.join("/") }, props: { summary } };
  });
};

interface Props {
  summary: CollectionEntry<"summaries">;
}

const { summary } = Astro.props;
const { Content } = await render(summary);

const creator = creatorSlug(summary.id);
const name = creatorName(creator);
const metaLink =
  "underline decoration-edge underline-offset-4 hover:text-ink hover:decoration-ink-muted";
---

<Base title={summary.data.title} description={summary.data.blurb}>
  <article data-pagefind-body>
    <header class="mb-10">
      <h1
        class="font-serif text-3xl leading-tight font-semibold tracking-tight text-balance text-ink-strong"
      >
        {summary.data.title}
      </h1>
      <!-- text-lg so 65ch resolves to the same width as the prose-lg body column. -->
      <div
        class="mt-3 flex max-w-[65ch] flex-wrap items-center justify-between gap-x-4 gap-y-2 text-lg"
      >
        <p class="text-base text-ink-muted">
          <a
            class={metaLink}
            href={`/${creator}/`}>{name}</a
          >
          <span aria-hidden="true"> · </span>
          <time datetime={summary.data.upload_date.toISOString()}>
            {formatDate(summary.data.upload_date)}
          </time>
          <span aria-hidden="true"> · </span>
          <a
            class={metaLink}
            href={summary.data.url}
            target="_blank"
            rel="noopener noreferrer">Source</a
          >
        </p>
        <nav aria-label="Topics" data-pagefind-ignore>
          <TopicLinks topics={summary.data.topics} size="sm" />
        </nav>
      </div>
      <p
        class="mt-8 max-w-[65ch] text-lg leading-relaxed text-ink text-pretty"
      >
        <strong class="font-semibold text-ink-strong">TLDR:</strong>{" "}
        {summary.data.blurb}
      </p>
    </header>

    <div
      class="prose prose-lg prose-headings:font-serif prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-2xl prose-h3:mt-8 prose-h3:text-xl prose-p:leading-[1.65] prose-a:underline-offset-2 prose-blockquote:not-italic prose-blockquote:font-normal prose-code:before:content-none prose-code:after:content-none prose-code:font-normal prose-th:text-left prose-td:align-top"
    >
      <Content />
    </div>
  </article>
</Base>
