---
import { getCollection } from "astro:content";
import CreatorCards from "../components/CreatorCards.astro";
import Base from "../layouts/Base.astro";
import { creatorName } from "../lib/creators";
import { byCreator } from "../lib/summaries";

// Driven by the Summaries on disk, not by creators.toml — deliberately unlike
// /topics, which lists its whole vocabulary. creators.toml also carries Creators
// that are only configured for ingest, and a reader clicking one would land on a
// page with nothing on it and no way to tell whether that is a bug.
const grouped = byCreator(await getCollection("summaries"));

const creators = [...grouped]
  .map(([slug, summaries]) => ({
    href: `/${slug}/`,
    name: creatorName(slug),
    count: summaries.length,
    latest: summaries[0]!.data.upload_date,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Base title="Creators — Market LLM Wiki" description="Everyone the wiki covers.">
  <header class="mb-12">
    <h1
      class="font-serif text-3xl font-semibold tracking-tight text-ink-strong"
    >
      Creators
    </h1>
  </header>

  <CreatorCards creators={creators} />
</Base>
