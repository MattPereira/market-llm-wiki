---
import Base from "../layouts/Base.astro";
---

{
  /*
   * Pagefind builds its index and ships its own UI as a postbuild step over
   * dist/, so these assets do not exist under plain `astro dev`. `pnpm dev:search`
   * copies a one-off index into public/ (stale until rerun). They are loaded
   * inline and only here, which is what keeps the rest of the site zero-JS.
   */
}
<Base
  title="Search — Market Wiki"
  description="Full-text search across every summary in the wiki."
>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <h1 class="sr-only">Search</h1>
  <div id="search"></div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    if (typeof PagefindUI === "undefined") {
      document.getElementById("search").textContent =
        "No search index here. Run `pnpm dev:search` to build one for the dev server.";
    } else {
      new PagefindUI({
        element: "#search",
        showImages: false,
        showSubResults: true,
      });
    }
  </script>
</Base>
